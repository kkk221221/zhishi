# Virtuoso Connection Parameters - Copy this to .env and fill in your actual values
VIRTUOSO_URL="http://localhost:8890/sparql"
VIRTUOSO_USER="dba"
VIRTUOSO_PASSWORD="your_virtuoso_password"

# Default Named Graph URI for the TCM Knowledge Graph
DEFAULT_GRAPH_URI="http://localhost:8890/TCMKG"

# Custom Namespace prefixes for your TCM specific ontology (if any)
# Replace with your actual ontology URIs if you have them
TCM_ONT_PREFIX="http://example.com/ontology/tcm#"
TCM_PROP_PREFIX="http://example.com/property/tcm#"
TCM_ENTITY_PREFIX="http://example.com/entity/tcm/"
